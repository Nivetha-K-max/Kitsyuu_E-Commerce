# KITSYUU Admin/ERP — copy to .env.local (git-ignored) and fill in. Server-side only: nothing here reaches the browser.

# Postgres connection for the kitsyuu_admin database role, through the Supabase pooler (transaction mode, port 6543):
#   postgresql://kitsyuu_admin.<project-ref>:<password>@<pooler-host>:6543/postgres
# Written by `npm run db:app-role -- --role=kitsyuu_admin --out-file=apps/admin/.env.local --var=ADMIN_DATABASE_URL` (the password is generated
# locally and never printed).
# SAFETY (2026-10-08): outside a production deployment (Vercel sets VERCEL=1 itself; any other host sets
# KITSYUU_DEPLOYMENT=production) the app refuses a database URL that is not on this machine. Locally, use the local test
# database (database/scripts/test-db.mjs writes its URLs to apps/admin/tests/.output/test.env). The hosted URL belongs in
# the hosting provider's settings, never in a local env file.
ADMIN_DATABASE_URL=

# Public base URL of this app, used in invitation and password-reset links (never taken from request headers).
ADMIN_APP_URL=http://localhost:3002

# Email delivery (customer and staff emails). Server-only; nothing here reaches the browser.
#   console (default) = nothing is delivered: each message, including links, goes to the server log. Use for development,
#                       tests and any machine that must not email real people.
#   file              = nothing is delivered: each message is written to MAIL_OUTBOX_DIR as .txt and .html, to look at what
#                       a customer would receive.
#   resend            = real delivery through Resend's API (chosen 2026-09-27). Needs RESEND_API_KEY (secret, starts with
#                       re_) and MAIL_FROM, the sender name and address on a domain verified in Resend, e.g.
#                       "KITSYUU <orders@your-domain>". MAIL_REPLY_TO is optional (where customer replies go).
# Production must set MAILER=resend in BOTH apps (store and admin): with it unset, customers receive nothing.
MAILER=console
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
# MAIL_OUTBOX_DIR=

# Public base URL of the existing product-images Storage bucket (public images; not a secret):
#   https://<project-ref>.supabase.co/storage/v1/object/public/product-images
PRODUCT_IMAGE_BASE_URL=

# Where uploaded product images are written: "supabase" (production: the product-images bucket, using the
# server-only service key below) or "local" (development/tests: a folder on disk, served by /media; never the live bucket).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=
# Only for STORAGE_DRIVER=supabase. Server-only: never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# M17: the public store address, used for links in customer emails (optional; emails omit the link when unset).
STORE_URL=
# M18: key that encrypts staff two-factor secrets: 32 random bytes, base64. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and stable (changing it switches off every enrolled authenticator). Unset = two-factor unavailable.
MFA_ENCRYPTION_KEY=

# ERP module 3: refunds through the payment provider (optional; off when unset: refunds are made outside the platform and
# recorded with their reference). "razorpay" uses the same Razorpay account as the store; "test" is for development only.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A live key (rzp_live_…) is refused for refunds unless this is exactly "on" (same setting as the store).
RAZORPAY_LIVE_MODE=
# Secret for the scheduled jobs, 32+ characters (Authorization: Bearer <secret>). Unset = every job answers 404.
#   /api/jobs/apply-prices       scheduled prices (otherwise applied when staff open Pricing)
#   /api/jobs/abandoned-checkouts  one reminder per unpaid order (switch: Settings → Customer emails)
#   /api/jobs/abandoned-carts      one "your cart is waiting" email per cart (2026-10-01; run every ~15 minutes)
#   /api/jobs/sync-tracking        courier tracking updates (no courier API is connected yet: checks nothing)
#   /api/jobs/retry-emails         sends again the order emails that failed and confirmations never attempted (2026-10-08;
#                                  run every 5-10 minutes; without a scheduler, retries still run when staff open Orders)
CRON_SECRET=
JOBS_SECRET=
# Minutes a cart must stay unchanged before the "your cart is waiting" email (15–1440; 45 when unset).
# ABANDONED_CART_DELAY_MINUTES=45
