# KITSYUU Admin/ERP — copy to .env.local (git-ignored) and fill in. Server-side only: nothing here reaches the browser.

# Postgres connection for the kitsyuu_admin database role, through the Supabase pooler (transaction mode, port 6543):
#   postgresql://kitsyuu_admin.<project-ref>:<password>@<pooler-host>:6543/postgres
# Written by `npm run db:app-role -- --role=kitsyuu_admin --out-file=apps/admin/.env.local --var=ADMIN_DATABASE_URL` (the password is generated
# locally and never printed).
ADMIN_DATABASE_URL=

# Public base URL of this app, used in invitation and password-reset links (never taken from request headers).
ADMIN_APP_URL=http://localhost:3002

# Email delivery: "console" (default; messages, including links, go to the server log) or "resend" (Resend's API, chosen
# 2026-09-27). For resend: RESEND_API_KEY (server-only secret, starts with re_) and MAIL_FROM, an address on a domain
# verified in Resend, e.g. "KITSYUU <orders@your-domain>". MAIL_REPLY_TO is optional.
MAILER=console
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# Public base URL of the existing product-images Storage bucket (public images; not a secret):
#   https://<project-ref>.supabase.co/storage/v1/object/public/product-images
PRODUCT_IMAGE_BASE_URL=

# Where uploaded product images are written: "supabase" (production: the product-images bucket, using the
# server-only service key below) or "local" (development/tests: a folder on disk, served by /media; never the live bucket).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=
# Only for STORAGE_DRIVER=supabase. Server-only: never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# M17: the public store address, used for links in customer emails (optional; emails omit the link when unset).
STORE_URL=
# M18: key that encrypts staff two-factor secrets: 32 random bytes, base64. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and stable (changing it switches off every enrolled authenticator). Unset = two-factor unavailable.
MFA_ENCRYPTION_KEY=

# ERP module 3: refunds through the payment provider (optional; off when unset: refunds are made outside the platform and
# recorded with their reference). "razorpay" uses the same Razorpay account as the store; "test" is for development only.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# ERP module 1: secret for the scheduled-price job (/api/jobs/apply-prices), 32+ characters. Unset = the job answers 404
# and scheduled prices are applied when staff open Pricing.
CRON_SECRET=
JOBS_SECRET=
