# KITSYUU customer website — environment variables (names and meaning only; never commit real values).
# Copy to .env.local for development. In Vercel, set them in the project's Environment Variables.

# ---- Catalogue (public, safe for the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public anon key>

# ---- Customer accounts (M6, server-only) ----
# Connection string for the kitsyuu_website database role. Created by:
#   npm run db:app-role -- --role=kitsyuu_website --out-file=apps/website/.env.local --var=WEBSITE_DATABASE_URL
WEBSITE_DATABASE_URL=
# Public base URL of this site, used for links in emails (confirmation, password reset). Never taken from the request.
SITE_URL=http://localhost:3001
# Email delivery. Only "console" exists until a provider is chosen: messages (including links) go to the server log.
MAILER=console
# Verify-on-login migration of accounts that still live in Supabase Auth. Set to "off" in tests, or once every
# account has moved to platform login.
LEGACY_SUPABASE_AUTH=on

# ---- Commerce (M7, server-only) ----
# Payment provider behind the payment interface. Leave EMPTY unless a provider is approved and configured: empty means no
# online payment (checkout says so and orders cannot be placed). A wrong or unusable value also switches payment OFF.
#   test     = development-only provider, opt-in: no money moves. Refused in production builds (logged as an error) unless
#              PAYMENTS_ALLOW_TEST_PROVIDER=on, which ONLY automated tests of a production build may set (logs a warning).
#              PAYMENTS_TEST_SECRET signs its simulated results (32+ random chars). Never use it for a real store.
#   razorpay = Razorpay (test mode only unless explicitly changed in code). Needs the RAZORPAY_* values below.
PAYMENT_PROVIDER=
PAYMENTS_TEST_SECRET=
PAYMENTS_ALLOW_TEST_PROVIDER=
# Razorpay (only with PAYMENT_PROVIDER=razorpay). The key id is sent to the browser by the server; the secrets never are.
# Webhook URL to register in Razorpay: <SITE_URL>/api/payments/webhook/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Scheduled jobs (POST /api/jobs/expire-orders with "Authorization: Bearer <JOBS_SECRET>"). Unset = the endpoint is off.
JOBS_SECRET=
