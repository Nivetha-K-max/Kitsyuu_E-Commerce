# KITSYUU customer website — environment variables (names and meaning only; never commit real values).
# Copy to .env.local for development. In Vercel, set them in the project's Environment Variables.

# ---- Catalogue (public, safe for the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public anon key>

# ---- Customer accounts (M6, server-only) ----
# Connection string for the kitsyuu_website database role. Created by:
#   npm run db:app-role -- --role=kitsyuu_website --out-file=apps/website/.env.local --var=WEBSITE_DATABASE_URL
# SAFETY (2026-10-08): outside a production deployment (Vercel sets VERCEL=1 itself; any other host sets
# KITSYUU_DEPLOYMENT=production) the app refuses a database URL that is not on this machine. Locally, use the local test
# database (database/scripts/test-db.mjs writes its URLs to apps/admin/tests/.output/test.env). The hosted URL belongs in
# the hosting provider's settings, never in a local env file.
WEBSITE_DATABASE_URL=
# Public base URL of this site, used for links in emails (confirmation, password reset) and for canonical / Open Graph /
# JSON-LD URLs, the sitemap and robots.txt. Never taken from the request.
SITE_URL=http://localhost:3001
# Store theme default: dark (default) or light. Visitors can switch in the header; their choice is kept in their browser.
# STORE_THEME=dark
# Email delivery (customer and staff emails). Server-only; nothing here reaches the browser.
#   console (default) = nothing is delivered: each message, including links, goes to the server log. Use for development,
#                       tests and any machine that must not email real people.
#   file              = nothing is delivered: each message is written to MAIL_OUTBOX_DIR as .txt and .html, to look at what
#                       a customer would receive.
#   resend            = real delivery through Resend's API (chosen 2026-09-27). Needs RESEND_API_KEY (secret, starts with
#                       re_) and MAIL_FROM, the sender name and address on a domain verified in Resend, e.g.
#                       "KITSYUU <orders@your-domain>". MAIL_REPLY_TO is optional (where customer replies go).
# Production must set MAILER=resend in BOTH apps (store and admin): with it unset, customers receive nothing.
MAILER=console
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
# MAIL_OUTBOX_DIR=
# Verify-on-login migration of accounts that still live in Supabase Auth. In a production deployment it is on unless set
# to "off" (set that once every account has moved to platform login). Anywhere else it is OFF unless set to "on" on
# purpose, so a local or test store never sends sign-in attempts to the hosted Supabase project.
# LEGACY_SUPABASE_AUTH=

# ---- Commerce (M7, server-only) ----
# Payment provider behind the payment interface. Leave EMPTY unless a provider is approved and configured: empty means no
# online payment (checkout says so and orders cannot be placed). A wrong or unusable value also switches payment OFF.
#   test     = development-only provider, opt-in: no money moves. Refused in production builds (logged as an error) unless
#              PAYMENTS_ALLOW_TEST_PROVIDER=on, which ONLY automated tests of a production build may set (logs a warning).
#              PAYMENTS_TEST_SECRET signs its simulated results (32+ random chars). Never use it for a real store.
#   razorpay = Razorpay, the store's payment gateway. Needs the RAZORPAY_* values below. Selected without usable
#              credentials = online payment stays OFF and checkout says it is temporarily unavailable (COD still works).
PAYMENT_PROVIDER=
PAYMENTS_TEST_SECRET=
PAYMENTS_ALLOW_TEST_PROVIDER=
# Razorpay (only with PAYMENT_PROVIDER=razorpay). The key id is sent to the browser by the server; the secrets never are.
# Webhook URL to register in Razorpay: <SITE_URL>/api/payments/webhook/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Live payments: a live key (rzp_live_…) is REFUSED unless this is exactly "on"; with it, RAZORPAY_WEBHOOK_SECRET is
# required as well. Leave empty until the live account is approved and the test-mode checks have passed.
RAZORPAY_LIVE_MODE=
# Scheduled job /api/jobs/expire-orders: cancels unpaid orders after the 10-day hold and returns their stock. Vercel Cron
# calls it daily (vercel.json) with "Authorization: Bearer <CRON_SECRET>"; another scheduler may POST with JOBS_SECRET.
# Both 32+ random characters. Unset = the endpoint is off (orders still expire before each customer's next checkout).
CRON_SECRET=
JOBS_SECRET=

# ---- Local development and tests only (2026-10-08) ----
# CATALOGUE_SOURCE=database reads the public catalogue and content from the LOCAL test database and serves product pictures
# from dist/store/images/products, so a local store, a test run or a load run never contacts the hosted project. It is
# refused in a deployment and refused together with a hosted public API URL. Build with: node apps/website/tests/build-local.mjs
# Known limit: no banners (the store's database role cannot read the banners table). Leave unset in production.
# CATALOGUE_SOURCE=
